rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: own profile only (FCM token storage)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Farms: creator must set themselves as owner; only owner can read/modify
    match /farms/{farmId} {
      allow create: if request.auth != null
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 100
          && request.resource.data.cropTypes is list
          && request.resource.data.cropTypes.size() >= 1
          && request.resource.data.cropTypes.size() <= 10
          && request.resource.data.cropTypes.hasOnly([
              'tomato', 'potato', 'eggplant', 'pepper', 'watermelon',
              'cantaloupe', 'honeydew', 'cucumber', 'squash', 'zucchini'
          ]);
      allow read, delete: if request.auth != null
          && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'latitude', 'longitude', 'cropTypes', 'plantingDate'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 100
          && request.resource.data.cropTypes is list
          && request.resource.data.cropTypes.size() >= 1
          && request.resource.data.cropTypes.size() <= 10
          && request.resource.data.cropTypes.hasOnly([
              'tomato', 'potato', 'eggplant', 'pepper', 'watermelon',
              'cantaloupe', 'honeydew', 'cucumber', 'squash', 'zucchini'
          ]);

      // Tasks: ownerId is denormalised onto each task document by Cloud Functions.
      // No get() calls → no extra billed reads.
      match /tasks/{taskId} {
        allow read: if request.auth != null
            && resource.data.ownerId == request.auth.uid;
        allow update: if request.auth != null
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status']);
        allow create, delete: if false; // Cloud Functions (Admin SDK) only
      }
    }
  }
}
