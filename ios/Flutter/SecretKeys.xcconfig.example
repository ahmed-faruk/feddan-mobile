// Copy this file to SecretKeys.xcconfig (gitignored) and fill in real values.
// Obtain MAPS_API_KEY from Google Cloud Console → enable "Maps SDK for iOS".
// Obtain REVERSED_CLIENT_ID from ios/Runner/GoogleService-Info.plist.

MAPS_API_KEY = YOUR_GOOGLE_MAPS_API_KEY
REVERSED_CLIENT_ID = YOUR_REVERSED_CLIENT_ID
